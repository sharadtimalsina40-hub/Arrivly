---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage = '/og-image.svg',
  theme = 'light',
  canonical,
  showMarketing = true,
} = Astro.props;

const finalOgTitle = ogTitle || title;
const finalOgDescription = ogDescription || description;
// Canonical: explicit prop wins; otherwise derive from the configured site + current path.
// Normalise the path to the no-trailing-slash form (root stays "/") so the
// auto-derived canonical matches the hardcoded ones and the sitemap.
const normalisedPath = Astro.url.pathname !== '/'
  ? Astro.url.pathname.replace(/\/$/, '')
  : '/';
const canonicalUrl = canonical || new URL(normalisedPath, Astro.site).href;
const dark = theme === 'dark';
const bodyCls = dark
  ? 'theme-dark bg-[#0a0a0a] text-white font-sans antialiased min-h-screen flex flex-col'
  : 'bg-paper text-ink font-sans antialiased min-h-screen flex flex-col';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="commission-factory-verification" content="03d28700e8194e67b6afcf8dcb41890a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Arrivly" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={finalOgTitle} />
    <meta property="og:description" content={finalOgDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalOgTitle} />
    <meta name="twitter:description" content={finalOgDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&display=swap" rel="stylesheet" />

    <!-- Page-specific head extras: JSON-LD, extra meta -->
    <slot name="head" />
  </head>
  <body class={bodyCls}>
    <Nav theme={theme} />
    <main class="flex-1">
      <slot />
    </main>
    {showMarketing && <Footer theme={theme} />}

    <!-- ── Email capture popup (timed, once per session) ── -->
    {showMarketing && <div id="arrivly-popup"
      class="theme-dark fixed inset-0 z-50 bg-black/70 hidden items-center justify-center p-4"
      role="dialog"
      aria-modal="true"
      aria-labelledby="arrivly-popup-heading">
      <div class="glass relative rounded-2xl max-w-md w-full p-8 bg-[#141416]/90">
        <button id="arrivly-popup-close"
          type="button"
          aria-label="Close"
          class="absolute top-3 right-4 text-white/40 hover:text-white transition-colors text-2xl leading-none">
          ×
        </button>

        <div id="arrivly-popup-form-container">
          <h3 id="arrivly-popup-heading"
            class="font-serif text-2xl font-light tracking-tight text-white mb-2 leading-tight">
            Get better deals in your inbox
          </h3>
          <p class="text-sm text-white/60 leading-relaxed mb-6">
            We'll email you when providers drop prices or launch student offers. No spam, unsubscribe anytime.
          </p>
          <form id="arrivly-popup-form" class="space-y-3" novalidate>
            <input
              id="arrivly-popup-email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
              class="w-full bg-white/10 border border-white/20 rounded-lg px-4 py-3 text-base text-white placeholder:text-white/40 focus:outline-none focus:border-accent transition-colors" />
            <button
              type="submit"
              class="w-full bg-accent text-ink font-medium py-3 rounded-lg hover:scale-[1.01] shadow-[0_0_24px_rgba(200,240,100,0.25)] transition-transform">
              Notify me
            </button>
          </form>
        </div>

        <div id="arrivly-popup-success"
          class="hidden text-green-500 text-base font-medium text-center py-8">
          You're in! We'll be in touch.
        </div>
      </div>
    </div>}

    {showMarketing && <script is:inline>
      (function () {
        var SHEET_URL = 'https://script.google.com/macros/s/AKfycbzZcrFrHRfha_xGF-8c6bbMP-VU74JzPV2xPGPWyYPaIE71vKj7ItU2vSuOqlp-cihZ/exec';
        var FLAG_KEY  = 'arrivly_popup_shown';

        // Bail if popup has already been shown this session
        try {
          if (sessionStorage.getItem(FLAG_KEY) === 'true') return;
        } catch (e) { /* sessionStorage blocked — proceed anyway */ }

        var modal     = document.getElementById('arrivly-popup');
        var closeBtn  = document.getElementById('arrivly-popup-close');
        var form      = document.getElementById('arrivly-popup-form');
        var formWrap  = document.getElementById('arrivly-popup-form-container');
        var success   = document.getElementById('arrivly-popup-success');
        var emailEl   = document.getElementById('arrivly-popup-email');
        if (!modal || !closeBtn || !form || !formWrap || !success || !emailEl) return;

        function open()  { modal.classList.remove('hidden'); modal.classList.add('flex'); }
        function close() {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          try { sessionStorage.setItem(FLAG_KEY, 'true'); } catch (e) {}
        }

        setTimeout(open, 20000);

        closeBtn.addEventListener('click', close);
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !modal.classList.contains('hidden')) close();
        });

        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var email = (emailEl.value || '').trim();
          if (!email || email.indexOf('@') === -1) {
            emailEl.focus();
            return;
          }

          // Google Apps Script + no-cors requires a simple content type;
          // we send the JSON body as text/plain and the script parses it.
          fetch(SHEET_URL, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify({ email: email, source: 'popup' })
          }).catch(function () { /* opaque — treat any completion as success */ });

          formWrap.classList.add('hidden');
          success.classList.remove('hidden');
          setTimeout(close, 2000);
        });
      })();
    </script>}
  </body>
</html>
