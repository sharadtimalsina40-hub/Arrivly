---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/commercial/Breadcrumbs.astro';
import SourceList from '../components/commercial/SourceList.astro';
import AuthorReview from '../components/commercial/AuthorReview.astro';
import CommercialCTA from '../components/commercial/CommercialCTA.astro';
import ImportantWarnings from '../components/commercial/ImportantWarnings.astro';

import {
  visaCover, providers, verdicts, suitability, scenarios, sources, warnings, lastReviewed,
} from '../data/commercial/health-insurance-page.js';

const providerById = (id) => {
  const p = providers.find((x) => x.id === id);
  if (!p) throw new Error(`health-insurance page references unknown provider id: ${id}`);
  return p;
};
const resolvedVerdicts = verdicts.map((v) => ({ ...v, provider: providerById(v.providerId) }));

// Full visa detail for the interactive tool (factual mapping + guidance).
const visaDetail = {
  '500': { label: 'Student Visa 500', cover: 'OSHC — Overseas Student Health Cover', explanation: 'OSHC is mandatory for all student visa holders. Buy it before you arrive; it must cover your entire visa period.', note: 'If you later move to a 485 visa, OSHC becomes invalid — you must switch to OVHC with no gap.' },
  '485': { label: 'Temporary Graduate 485', cover: 'OVHC — Overseas Visitors Health Cover', explanation: 'Moving from a student visa to a 485 makes your OSHC invalid. Switch to OVHC before the student visa ends.', note: 'One of the most common coverage mistakes — OSHC does not carry over.' },
  '482': { label: 'Skills in Demand 482', cover: 'OVHC — Workers Cover', explanation: 'Compliant OVHC is required under Condition 8501. Your employer may arrange it — confirm in writing.', note: 'The 482 replaced the old 457 visa. Check who is responsible for the cost.' },
  '491': { label: 'Skilled Work Regional 491', cover: 'OVHC — Workers Cover', explanation: 'Hold compliant OVHC for the full duration, with hospital and medical treatment cover.', note: 'You must live and work regionally — check the insurer covers your area.' },
  'bridging': { label: 'Bridging Visa (A/B/C/E)', cover: 'OVHC — depends on previous visa', explanation: 'Continue OVHC without a gap if you held a work visa; switch from OSHC to OVHC if you held a student visa.', note: 'Bridging holders are most at risk of a coverage gap — manage it yourself.' },
  'other': { label: 'Other work visa (407/408/494)', cover: 'OVHC — Workers Cover', explanation: 'Most temporary work/training visas include Condition 8501 requiring compliant cover.', note: 'Unsure which condition applies? Check your grant notice via VEVO.' },
};
const serialisedVisa = JSON.stringify(visaDetail);

const coverBadge = (c) => (c.startsWith('OSHC') ? 'text-accent' : 'text-white/80');

// ── SEO ──
const pageTitle = 'Compare Health Insurance for International Students | Arrivly';
const pageDescription =
  'Compare OSHC and OVHC options for international students and visa holders in Australia — by visa type, cover level, waiting periods and important exclusions. General information, not advice.';
const canonical = 'https://arrivly.com.au/health-insurance';

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: 'Compare Health Insurance for International Students and Visa Holders', description: pageDescription, url: canonical, dateModified: lastReviewed, publisher: { '@type': 'Organization', name: 'Arrivly', url: 'https://arrivly.com.au' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://arrivly.com.au/' },
    { '@type': 'ListItem', position: 2, name: 'Health insurance', item: canonical },
  ] },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: 'Health cover guidance by visa type', itemListElement: resolvedVerdicts.map((v, i) => ({ '@type': 'ListItem', position: i + 1, name: `${v.category}: ${v.coverType}` })) },
];
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonical} theme="dark">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="relative hero-glow grain">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-8 pb-16 sm:pb-24 relative">

      <!-- 1. Breadcrumbs -->
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Health insurance' }]} />

      <!-- 2. Hero -->
      <header class="mt-10 sm:mt-16 mb-14 sm:mb-20">
        <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-white/50 mb-5">For visa holders &amp; international students</p>
        <h1 class="font-serif text-4xl sm:text-6xl font-light tracking-tight text-white leading-[1.05] max-w-3xl mb-6">
          Compare health insurance for international students and visa holders
        </h1>
        <p class="text-base sm:text-lg text-white/70 leading-relaxed max-w-2xl mb-8">
          Start with the one thing that decides everything: <span class="text-accent">your visa</span>. It sets
          whether you need OSHC or OVHC. From there, compare cover level, waiting periods and the exclusions
          students most often miss.
        </p>
        <div class="flex flex-wrap items-center gap-3 mb-8">
          <a href="#finder" class="inline-flex items-center gap-2 bg-accent text-ink px-7 py-3.5 rounded-full text-sm font-medium hover:scale-[1.03] shadow-[0_0_28px_rgba(200,240,100,0.28)] transition-transform">Compare health insurance <span aria-hidden="true">→</span></a>
          <a href="#top-picks" class="glass inline-flex items-center gap-2 px-7 py-3.5 rounded-full text-sm font-medium text-white hover:border-white/30 transition-colors">See top choices</a>
        </div>
        <div class="glass rounded-2xl px-5 py-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-white/60">
          <span><strong class="text-accent font-semibold">{visaCover.length}</strong> visa types mapped</span>
          <span><strong class="text-accent font-semibold">{providers.length}</strong> providers referenced</span>
          <span>Reviewed <strong class="text-white/80">{lastReviewed}</strong></span>
          <a href="#methodology" class="underline decoration-accent decoration-2 underline-offset-2 hover:text-white transition-colors">How we compare</a>
          <a href="/affiliate-disclosure" class="underline decoration-accent decoration-2 underline-offset-2 hover:text-white transition-colors">Affiliate disclosure</a>
        </div>
        <p class="mt-4 text-xs text-white/40 max-w-2xl leading-relaxed">
          ⓘ General comparison information only — <strong class="text-white/60">not personalised migration, legal or medical advice</strong>.
          Prices shown are indicative starting points, not quotes. Verify your visa's cover requirements with the
          <a href="https://immi.homeaffairs.gov.au" target="_blank" rel="noopener" class="underline decoration-accent decoration-2 underline-offset-2">Department of Home Affairs</a> or a qualified professional.
        </p>
      </header>

      <!-- 3. Verdict — by visa/user type (factual), not price ranking -->
      <section id="top-picks" class="mb-16 sm:mb-24 scroll-mt-24">
        <h2 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-white leading-[1.1] mb-3">The short answer</h2>
        <p class="text-sm text-white/50 mb-8 max-w-2xl">Your visa decides your cover type. These are framed by situation — we don't rank insurers on price, because pricing here is indicative and not verified.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {resolvedVerdicts.map((v) => (
            <article class="glass rounded-2xl p-6 flex flex-col">
              <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-accent mb-3">{v.category}</p>
              <div class="flex items-baseline gap-2 mb-3">
                <h3 class="font-serif text-xl font-light tracking-tight text-white leading-snug">You need {v.coverType}</h3>
              </div>
              <p class="text-sm text-white/60 leading-relaxed flex-1">{v.reason}</p>
              <p class="text-xs text-white/40 mt-4">Sold by {v.provider.name} and other major funds · reviewed {lastReviewed}</p>
              <a href="#finder" class="inline-flex items-center justify-center gap-1.5 border border-white/15 text-white text-sm font-medium py-2.5 rounded-full hover:border-accent hover:text-accent transition-colors mt-4">Check my visa <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </section>

      <!-- 4. Provider reference table (indicative) -->
      <section class="mb-16 sm:mb-24">
        <h2 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-white leading-[1.1] mb-3">Providers at a glance</h2>
        <p class="text-sm text-white/50 mb-6 max-w-2xl">Indicative single-adult starting prices to orient you — <strong class="text-white/70">not quotes</strong>. Your actual premium depends on your dates, cover level, excess and policy type.</p>
        <div class="glass rounded-2xl overflow-x-auto">
          <table class="w-full min-w-[720px] text-sm text-left">
            <thead>
              <tr class="border-b border-white/10 text-[11px] uppercase tracking-[0.14em] text-white/40">
                <th scope="col" class="px-5 py-4 font-bold">Provider</th>
                <th scope="col" class="px-4 py-4 font-bold">Cover type</th>
                <th scope="col" class="px-4 py-4 font-bold">Visa types</th>
                <th scope="col" class="px-4 py-4 font-bold">Indicative from</th>
                <th scope="col" class="px-4 py-4 font-bold">Notable</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.06]">
              {providers.map((p) => (
                <tr>
                  <th scope="row" class="px-5 py-4 font-medium text-white whitespace-nowrap">{p.name}</th>
                  <td class="px-4 py-4 text-white/70 whitespace-nowrap">{p.cover}</td>
                  <td class="px-4 py-4 text-white/60">{p.visas.join(', ')}</td>
                  <td class="px-4 py-4 whitespace-nowrap"><span class="text-white/80 tabular-nums">~${p.indicative_from_aud}</span><span class="text-white/40 text-xs">/mo*</span></td>
                  <td class="px-4 py-4 text-white/60">{p.highlight}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-xs text-white/30 mt-3">* Indicative single-adult starting price, not a quote. Couple and family cover cost more. Always get a dated quote for your exact circumstances.</p>
      </section>

      <!-- 5. Interactive visa tool -->
      <section id="finder" class="mb-16 sm:mb-24 scroll-mt-24">
        <h2 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-white leading-[1.1] mb-3">Which cover does your visa need?</h2>
        <p class="text-sm text-white/50 mb-8 max-w-2xl">Pick your visa subclass. The visa → cover-type mapping is factual general information; use it as a starting point, then verify your exact requirement officially.</p>

        <div class="glass rounded-3xl p-6 sm:p-10">
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3" role="group" aria-label="Select your visa">
            {Object.entries(visaDetail).map(([code, v]) => (
              <button class="visa-btn text-left border border-white/10 rounded-xl p-4 hover:border-white/30 hover:bg-white/[0.05] transition-all duration-150" data-code={code}>
                <p class="font-semibold text-white text-sm">{v.label}</p>
              </button>
            ))}
          </div>

          <div id="visa-result" class="hidden mt-8 pt-8 border-t border-white/10">
            <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-accent mb-2">You need</p>
            <h3 id="visa-cover" class="font-serif text-2xl sm:text-3xl font-light tracking-tight text-white mb-4 leading-tight"></h3>
            <p id="visa-explanation" class="text-sm text-white/70 leading-relaxed mb-4 max-w-2xl"></p>
            <div class="rounded-xl bg-white/[0.04] border border-white/10 p-4 max-w-2xl">
              <p class="text-xs text-amber-300 leading-relaxed"><span class="font-semibold">Watch out — </span><span id="visa-note"></span></p>
            </div>
            <p class="mt-5 text-xs text-white/40">This mapping is general information. Confirm your specific requirement with the Department of Home Affairs.</p>
          </div>
        </div>
      </section>

      <!-- 6. Who each suits -->
      <section class="mb-16 sm:mb-24">
        <h2 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-white leading-[1.1] mb-8">Which situation are you in?</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {suitability.map((s) => (
            <article class="glass rounded-2xl p-6 flex flex-col">
              <h3 class="font-semibold text-white mb-2">{s.situation}</h3>
              <p class="text-xs text-white/40 mb-3"><span class="text-white/60 font-medium">What matters:</span> {s.matters}</p>
              <p class="text-sm text-white/60 leading-relaxed flex-1">{s.reasoning}</p>
              <p class="mt-4 text-sm"><span class="text-white/40">Cover type:</span> <span class="text-accent font-medium ml-1">{s.coverType}</span></p>
            </article>
          ))}
        </div>
      </section>

      <!-- 7. Cost & feature guidance -->
      <section class="mb-16 sm:mb-24">
        <h2 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-white leading-[1.1] mb-8">OSHC, OVHC and what to compare</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="glass rounded-2xl p-6"><h3 class="font-semibold text-white mb-2">OSHC vs OVHC</h3><p class="text-sm text-white/60 leading-relaxed">OSHC is for student visa (500) holders and is mandatory. OVHC is for most other temporary visas (485, 482, 491, bridging). Your visa decides which one you need.</p></div>
          <div class="glass rounded-2xl p-6"><h3 class="font-semibold text-white mb-2">Single, couple &amp; family</h3><p class="text-sm text-white/60 leading-relaxed">A couple or family policy usually costs less than separate singles for the same dates — but everyone on your visa must be covered.</p></div>
          <div class="glass rounded-2xl p-6"><h3 class="font-semibold text-white mb-2">Waiting periods</h3><p class="text-sm text-white/60 leading-relaxed">Many services have waiting periods — pre-existing conditions and pregnancy especially. Switching insurers can reset them.</p></div>
          <div class="glass rounded-2xl p-6"><h3 class="font-semibold text-white mb-2">Pharmaceutical &amp; extras</h3><p class="text-sm text-white/60 leading-relaxed">Prescription benefits are capped (per-item and annual limits). Extras like dental and optical are usually a separate add-on, not part of base cover.</p></div>
          <div class="glass rounded-2xl p-6"><h3 class="font-semibold text-white mb-2">Direct billing &amp; networks</h3><p class="text-sm text-white/60 leading-relaxed">Some providers offer direct billing at partner clinics (no upfront payment); availability varies by location and provider network.</p></div>
          <div class="glass rounded-2xl p-6"><h3 class="font-semibold text-white mb-2">Start dates &amp; switching</h3><p class="text-sm text-white/60 leading-relaxed">Cover must be active from arrival. When switching (e.g. OSHC → OVHC at graduation), line the dates up so there's no gap.</p></div>
        </div>
      </section>

      <!-- 8. Methodology -->
      <section id="methodology" class="mb-16 sm:mb-24 scroll-mt-24">
        <h2 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-white leading-[1.1] mb-3">How Arrivly evaluates cover</h2>
        <div class="glass rounded-2xl p-6 sm:p-8">
          <ol class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3 text-sm text-white/70">
            {['Suitability for your visa category', 'Total policy cost for your dates', 'Core hospital and medical coverage', 'Waiting periods', 'Pharmaceutical benefit limits', 'Excess and out-of-pocket exposure', 'Direct-billing access', 'Flexibility for couples and families', 'Extras availability', 'Transparency of exclusions'].map((factor, i) => (
              <li class="flex items-baseline gap-3">
                <span class="font-mono text-accent text-xs shrink-0">{String(i + 1).padStart(2, '0')}</span>
                <span>{factor}</span>
              </li>
            ))}
          </ol>
          <p class="text-sm text-white/50 leading-relaxed mt-6 pt-6 border-t border-white/10">
            Arrivly does <strong class="text-white/70">not</strong> confirm visa compliance for any individual. Users should verify the cover
            requirements for their visa and circumstances through official sources or a qualified professional. We hold no insurer
            affiliate relationships yet, so no commission influences this page.
          </p>
        </div>
      </section>

      <!-- 9. Pros & cons — cover types, not fabricated per-policy claims -->
      <section class="mb-16 sm:mb-24">
        <h2 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-white leading-[1.1] mb-8">OSHC vs OVHC — strengths and limits</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <article class="glass rounded-2xl p-6 sm:p-7">
            <h3 class="font-serif text-xl font-light tracking-tight text-white mb-4">OSHC (students)</h3>
            <div class="space-y-2.5">
              <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-white/40">Strengths</p>
              <ul class="space-y-2 text-sm text-white/70">
                <li class="flex gap-2.5"><span class="text-accent shrink-0">✓</span>Purpose-built to meet the 500 visa condition</li>
                <li class="flex gap-2.5"><span class="text-accent shrink-0">✓</span>Generally cheaper than OVHC</li>
                <li class="flex gap-2.5"><span class="text-accent shrink-0">✓</span>Sold by every major fund</li>
              </ul>
              <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-white/40 pt-2">Limitations</p>
              <ul class="space-y-2 text-sm text-white/70">
                <li class="flex gap-2.5"><span class="text-white/30 shrink-0">–</span>Becomes invalid once your student visa ends</li>
                <li class="flex gap-2.5"><span class="text-white/30 shrink-0">–</span>Capped pharmaceutical benefits; extras not included</li>
              </ul>
            </div>
          </article>
          <article class="glass rounded-2xl p-6 sm:p-7">
            <h3 class="font-serif text-xl font-light tracking-tight text-white mb-4">OVHC (most other visas)</h3>
            <div class="space-y-2.5">
              <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-white/40">Strengths</p>
              <ul class="space-y-2 text-sm text-white/70">
                <li class="flex gap-2.5"><span class="text-accent shrink-0">✓</span>Meets Condition 8501 for work/graduate visas</li>
                <li class="flex gap-2.5"><span class="text-accent shrink-0">✓</span>Available at multiple cover levels</li>
                <li class="flex gap-2.5"><span class="text-accent shrink-0">✓</span>Bridges the gap when OSHC ends</li>
              </ul>
              <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-white/40 pt-2">Limitations</p>
              <ul class="space-y-2 text-sm text-white/70">
                <li class="flex gap-2.5"><span class="text-white/30 shrink-0">–</span>Usually costs more than OSHC</li>
                <li class="flex gap-2.5"><span class="text-white/30 shrink-0">–</span>Cover levels vary — check hospital and waiting terms</li>
              </ul>
            </div>
          </article>
        </div>
      </section>

      <!-- 10. Warnings -->
      <section class="mb-16 sm:mb-24">
        <h2 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-white leading-[1.1] mb-8">Before you buy — the things people miss</h2>
        <ImportantWarnings items={warnings} />
      </section>

      <!-- 11. Scenarios -->
      <section class="mb-16 sm:mb-24">
        <h2 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-white leading-[1.1] mb-8">Common situations</h2>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
          {scenarios.map((s) => (
            <article class="glass rounded-2xl p-6 flex flex-col">
              <h3 class="font-serif text-xl font-light tracking-tight text-white leading-snug mb-4">{s.title}</h3>
              <dl class="space-y-3 text-sm flex-1">
                <div><dt class="text-[11px] font-bold uppercase tracking-[0.14em] text-white/40 mb-1">Needs</dt><dd class="text-white/60 leading-relaxed">{s.needs}</dd></div>
                <div><dt class="text-[11px] font-bold uppercase tracking-[0.14em] text-white/40 mb-1">Cover type</dt><dd class="text-white/60">{s.coverType}</dd></div>
                <div><dt class="text-[11px] font-bold uppercase tracking-[0.14em] text-white/40 mb-1">The trade-off</dt><dd class="text-white/60 leading-relaxed">{s.tradeoff}</dd></div>
                <div><dt class="text-[11px] font-bold uppercase tracking-[0.14em] text-accent mb-1">Where we land</dt><dd class="text-white/80 leading-relaxed">{s.outcome}</dd></div>
              </dl>
            </article>
          ))}
        </div>
      </section>

      <!-- 12. Insight — the visa→cover decision path -->
      <section class="mb-16 sm:mb-24">
        <h2 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-white leading-[1.1] mb-3">The one rule that decides your cover</h2>
        <p class="text-sm text-white/50 mb-6 max-w-2xl">Ignore the marketing. Your visa subclass alone determines whether you need OSHC or OVHC:</p>
        <div class="glass rounded-2xl overflow-hidden">
          <div class="divide-y divide-white/[0.06]">
            {visaCover.map((v) => (
              <div class="flex items-center gap-4 px-5 sm:px-8 py-4">
                <span class="font-mono text-xs text-white/40 w-16 shrink-0">{v.code.toUpperCase()}</span>
                <span class="text-white/80 text-sm flex-1 min-w-0">{v.name}</span>
                <span aria-hidden="true" class="text-white/30">→</span>
                <span class={`font-serif text-lg font-light shrink-0 ${coverBadge(v.cover)}`}>{v.cover}</span>
              </div>
            ))}
          </div>
        </div>
        <p class="text-xs text-white/30 mt-3">Condition 8501 (adequate health cover for your whole stay) applies to most temporary visas. Verify yours via the Department of Home Affairs.</p>
      </section>

      <!-- 13. Sources -->
      <section class="mb-16 sm:mb-24">
        <h2 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-white leading-[1.1] mb-3">Sources and data notes</h2>
        <p class="text-sm text-white/50 mb-6 max-w-2xl">Government and provider references. Editorial citations — not affiliate links.</p>
        <SourceList sources={sources} />
      </section>

      <!-- 14. Author -->
      <section class="mb-16 sm:mb-24">
        <AuthorReview publishedDate="2026-07-21" reviewedDate="2026-07-21" verifiedDate={lastReviewed} />
      </section>

      <!-- 15. CTA -->
      <div class="mb-16 sm:mb-24">
        <CommercialCTA heading="Work out your cover in one step" body="Tell us your visa subclass and we'll show whether you need OSHC or OVHC, plus the exclusions to check before you buy." ctaText="Compare health insurance" ctaHref="#finder" />
      </div>

      <!-- 16. Related guides -->
      <section class="mb-8">
        <h2 class="font-serif text-2xl sm:text-3xl font-light tracking-tight text-white leading-[1.1] mb-6">Keep reading</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a href="/sim-cards" class="glass rounded-2xl p-6 hover:border-white/25 transition-colors group"><p class="text-[11px] font-bold uppercase tracking-[0.18em] text-white/40 mb-2">Compare</p><p class="font-serif text-lg font-light text-white leading-snug group-hover:text-accent transition-colors">Best SIM cards for international students</p></a>
          <a href="/money-transfer" class="glass rounded-2xl p-6 hover:border-white/25 transition-colors group"><p class="text-[11px] font-bold uppercase tracking-[0.18em] text-white/40 mb-2">Compare</p><p class="font-serif text-lg font-light text-white leading-snug group-hover:text-accent transition-colors">Send money home for less</p></a>
          <a href="/blog/how-i-saved-fees-money-as-international-student-raiz" class="glass rounded-2xl p-6 hover:border-white/25 transition-colors group"><p class="text-[11px] font-bold uppercase tracking-[0.18em] text-white/40 mb-2">Guide</p><p class="font-serif text-lg font-light text-white leading-snug group-hover:text-accent transition-colors">The app that saved me when uni fees were due</p></a>
          <a href="/about" class="glass rounded-2xl p-6 hover:border-white/25 transition-colors group"><p class="text-[11px] font-bold uppercase tracking-[0.18em] text-white/40 mb-2">About</p><p class="font-serif text-lg font-light text-white leading-snug group-hover:text-accent transition-colors">Why Arrivly exists, and how we make money</p></a>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>

<script define:vars={{ serialisedVisa }}>
  const VISA = JSON.parse(serialisedVisa);
  const resultEl = document.getElementById('visa-result');
  const coverEl = document.getElementById('visa-cover');
  const explEl = document.getElementById('visa-explanation');
  const noteEl = document.getElementById('visa-note');
  const SELECTED = ['border-accent', 'bg-white/[0.08]'];

  document.querySelectorAll('.visa-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.visa-btn').forEach((b) => b.classList.remove(...SELECTED));
      btn.classList.add(...SELECTED);
      const v = VISA[btn.dataset.code];
      if (!v) return;
      coverEl.textContent = v.cover;
      explEl.textContent = v.explanation;
      noteEl.textContent = v.note;
      resultEl.classList.remove('hidden');
      resultEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  });
</script>
