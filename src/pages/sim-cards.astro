---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/commercial/Breadcrumbs.astro';
import RecommendationCard from '../components/commercial/RecommendationCard.astro';
import ProsCons from '../components/commercial/ProsCons.astro';
import SourceList from '../components/commercial/SourceList.astro';
import AuthorReview from '../components/commercial/AuthorReview.astro';
import CommercialCTA from '../components/commercial/CommercialCTA.astro';

import plans from '../data/sim-plans.js';
import stats, { effectiveAnnualCost, dataDisplay } from '../data/sim-stats.js';
import { picks, suitability, scenarios, sources } from '../data/commercial/sim-cards-page.js';

const serialisedPlans = JSON.stringify(plans);

// ── Resolve content-model references to real plan records (throws on bad id) ──
const planById = (id) => {
  const p = plans.find((x) => x.id === id);
  if (!p) throw new Error(`sim-cards page references unknown plan id: ${id}`);
  return p;
};
const resolvedPicks = picks.map((pick) => ({ ...pick, plan: planById(pick.planId) }));
const resolvedSuitability = suitability.map((s) => ({ ...s, plan: planById(s.planId) }));
const resolvedScenarios = scenarios.map((s) => ({ ...s, considered: s.consideredIds.map(planById) }));
const pickIds = new Set(picks.map((p) => p.planId));

// ── Affiliate vs official CTA (same rule the finder uses client-side) ──
const ctaUrl = (plan) =>
  plan.affiliate_url && plan.affiliate_url !== 'PLACEHOLDER' ? plan.affiliate_url : plan.official_url;
const ctaRel = (plan) =>
  plan.affiliate_url && plan.affiliate_url !== 'PLACEHOLDER' ? 'sponsored noopener noreferrer' : 'noopener';

const cycleLabel = (plan) =>
  plan.billing_cycle_days === 30 ? 'Monthly' : `${plan.billing_cycle_days} days`;
const priceUnit = (plan) =>
  plan.billing_cycle_days === 30 ? '/month' : `/${plan.billing_cycle_days} days`;

// Table rows sorted: picks first (in pick order), then remaining by price.
const pickOrder = picks.map((p) => p.planId);
const tablePlans = [...plans].sort((a, b) => {
  const ai = pickOrder.indexOf(a.id);
  const bi = pickOrder.indexOf(b.id);
  if (ai !== -1 && bi !== -1) return ai - bi;
  if (ai !== -1) return -1;
  if (bi !== -1) return 1;
  return a.price_ongoing_aud - b.price_ongoing_aud;
});

const intlSummary = (plan) => {
  const c = plan.international_calls;
  if (!c.included) return 'Not included';
  const parts = [];
  if (c.unlimited_countries.length) parts.push(`Unlimited to ${c.unlimited_countries.length} countries`);
  if (c.nepal_minutes > 0) parts.push(`${c.nepal_minutes}m Nepal`);
  if (!parts.length) parts.push('Included — verify list');
  return parts.join(' · ');
};
const bestForLabels = {
  'calling-home': 'Calling home', 'data-heavy': 'Heavy data', budget: 'Budget',
  metro: 'Metro', regional: 'Regional', balanced: 'Balanced', 'short-stay': 'Short stay',
};
const bestForText = (plan) => plan.best_for.map((t) => bestForLabels[t] || t).join(', ');

// ── SEO ──
const pageTitle = 'Best SIM Cards for International Students Australia (2026) | Arrivly';
const pageDescription =
  'Compare SIM plans for international students in Australia. Ongoing prices, data, networks and international-call inclusions for 12 manually verified prepaid plans.';
const canonical = 'https://arrivly.com.au/sim-cards';

// ── JSON-LD — only what is visibly on the page. No ratings, no reviews. ──
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Best SIM Cards for International Students in Australia',
    description: pageDescription,
    url: canonical,
    dateModified: stats.latestVerified,
    publisher: { '@type': 'Organization', name: 'Arrivly', url: 'https://arrivly.com.au' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://arrivly.com.au/' },
      { '@type': 'ListItem', position: 2, name: 'SIM cards', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Recommended SIM plans for international students in Australia',
    itemListElement: resolvedPicks.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${p.category}: ${p.plan.name}`,
      url: p.plan.official_url,
    })),
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  theme="dark">

  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="relative hero-glow grain">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-8 pb-16 sm:pb-24 relative">

      <!-- ── 1. Breadcrumbs ── -->
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'SIM cards' }]} />

      <!-- ── 2. Hero / direct answer ── -->
      <header class="mt-10 sm:mt-16 mb-14 sm:mb-20">
        <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-white/50 mb-5">
          For visa holders &amp; international students in Australia
        </p>
        <h1 class="font-serif text-4xl sm:text-6xl font-light tracking-tight text-white leading-[1.05] max-w-3xl mb-6">
          Best SIM cards for international students in Australia
        </h1>
        <p class="text-base sm:text-lg text-white/70 leading-relaxed max-w-2xl mb-8">
          Compare prepaid SIM plans on data, ongoing cost, network, international calls and how long
          you plan to stay. Every plan below was checked by hand against the provider's own site —
          including which ones actually include calls to Nepal, India and the Philippines.
        </p>

        <div class="flex flex-wrap items-center gap-3 mb-8">
          <a href="#finder"
            class="inline-flex items-center gap-2 bg-accent text-ink px-7 py-3.5 rounded-full text-sm font-medium hover:scale-[1.03] shadow-[0_0_28px_rgba(200,240,100,0.28)] transition-transform">
            Compare SIM plans <span aria-hidden="true">→</span>
          </a>
          <a href="#top-picks"
            class="glass inline-flex items-center gap-2 px-7 py-3.5 rounded-full text-sm font-medium text-white hover:border-white/30 transition-colors">
            See top choices
          </a>
        </div>

        <!-- Trust row — all values computed from src/data/sim-plans.js -->
        <div class="glass rounded-2xl px-5 py-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-white/60">
          <span><strong class="text-accent font-semibold">{stats.planCount}</strong> plans compared</span>
          <span><strong class="text-accent font-semibold">{stats.providerCount}</strong> providers</span>
          <span>Data verified <strong class="text-white/80">{stats.latestVerified}</strong></span>
          <a href="#methodology" class="underline decoration-accent decoration-2 underline-offset-2 hover:text-white transition-colors">How we compare</a>
          <a href="/affiliate-disclosure" class="underline decoration-accent decoration-2 underline-offset-2 hover:text-white transition-colors">Some links earn us a commission</a>
        </div>
      </header>

      <!-- ── 3. Direct recommendation summary ── -->
      <section id="top-picks" class="mb-16 sm:mb-24 scroll-mt-24">
        <h2 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-white leading-[1.1] mb-3">
          The short answer
        </h2>
        <p class="text-sm text-white/50 mb-8 max-w-2xl">
          Five situations cover most new arrivals. These picks mirror the same logic the comparison
          tool uses — no eSIM category yet because we haven't verified eSIM availability per plan.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {resolvedPicks.map((pick) => (
            <RecommendationCard
              category={pick.category}
              plan={pick.plan}
              reason={pick.reason}
              priceUnit={priceUnit(pick.plan)}
              dataLabel={dataDisplay(pick.plan)}
              ctaHref={ctaUrl(pick.plan)}
              ctaRel={ctaRel(pick.plan)}
            />
          ))}
        </div>
      </section>

      <!-- ── 4. Top choices at a glance (semantic table) ── -->
      <section class="mb-16 sm:mb-24">
        <h2 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-white leading-[1.1] mb-3">
          All {stats.planCount} plans at a glance
        </h2>
        <p class="text-sm text-white/50 mb-6 max-w-2xl">
          "Effective per year" is the ongoing price multiplied by real renewals per year
          (365 ÷ renewal days) — 28-day plans bill 13 times a year, not 12.
        </p>
        <div class="glass rounded-2xl overflow-x-auto">
          <table class="w-full min-w-[960px] text-sm text-left">
            <thead>
              <tr class="border-b border-white/10 text-[11px] uppercase tracking-[0.14em] text-white/40">
                <th scope="col" class="px-5 py-4 font-bold">Plan</th>
                <th scope="col" class="px-4 py-4 font-bold">Ongoing price</th>
                <th scope="col" class="px-4 py-4 font-bold">Renews</th>
                <th scope="col" class="px-4 py-4 font-bold">Effective / year</th>
                <th scope="col" class="px-4 py-4 font-bold">Data</th>
                <th scope="col" class="px-4 py-4 font-bold">Network</th>
                <th scope="col" class="px-4 py-4 font-bold">International calls</th>
                <th scope="col" class="px-4 py-4 font-bold">Best for</th>
                <th scope="col" class="px-4 py-4 font-bold"><span class="sr-only">Link</span></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.06]">
              {tablePlans.map((plan) => (
                <tr class={pickIds.has(plan.id) ? 'bg-accent/[0.04]' : ''}>
                  <th scope="row" class="px-5 py-4 font-medium text-white whitespace-nowrap">
                    {pickIds.has(plan.id) && (
                      <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent mr-2 align-middle" title="Arrivly pick"></span>
                    )}
                    {plan.name}
                    <span class="block text-[11px] font-normal text-white/40 mt-0.5">{plan.provider}</span>
                  </th>
                  <td class="px-4 py-4 text-white/80 whitespace-nowrap">
                    ${plan.price_ongoing_aud}
                    {plan.price_intro_note && (
                      <span class="block text-[11px] text-accent/80 mt-0.5">Intro: {plan.price_intro_note}</span>
                    )}
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap">
                    <span class={plan.billing_warning ? 'text-amber-300' : 'text-white/60'}>{cycleLabel(plan)}</span>
                  </td>
                  <td class="px-4 py-4 font-semibold text-accent whitespace-nowrap">${effectiveAnnualCost(plan)}</td>
                  <td class="px-4 py-4 text-white/80 whitespace-nowrap">{dataDisplay(plan)}</td>
                  <td class="px-4 py-4 text-white/60 whitespace-nowrap">{plan.network}</td>
                  <td class="px-4 py-4 text-white/60 max-w-[220px]">{intlSummary(plan)}</td>
                  <td class="px-4 py-4 text-white/60 whitespace-nowrap">{bestForText(plan)}</td>
                  <td class="px-4 py-4">
                    <a href={ctaUrl(plan)} target="_blank" rel={ctaRel(plan)}
                      class="inline-flex items-center gap-1 text-xs font-medium text-white border border-white/15 rounded-full px-3.5 py-1.5 hover:border-accent hover:text-accent transition-colors whitespace-nowrap">
                      View <span aria-hidden="true">↗</span>
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-xs text-white/30 mt-3">
          Rows with a <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent align-middle mx-0.5"></span> dot are the picks from the summary above.
          Lycamobile quotas and country lists still need click-through verification. eSIM availability not yet verified for any plan.
        </p>
      </section>

      <!-- ── 5. Interactive comparison tool ── -->
      <section id="finder" class="mb-16 sm:mb-24 scroll-mt-24">
        <h2 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-white leading-[1.1] mb-3">
          Find the right SIM plan for your situation
        </h2>
        <p class="text-sm text-white/50 mb-8 max-w-2xl">
          Three questions. The tool filters and ranks the same {stats.planCount} plans using your
          priorities (data, budget, calling home), your length of stay, and — because inclusion
          lists differ wildly — the exact country you call most.
        </p>

        <!-- ── Wizard (logic unchanged — filter-then-score) ── -->
        <div id="wizard" class="glass rounded-3xl overflow-hidden">

          <div class="flex gap-1.5 px-8 pt-6">
            <div class="progress-seg h-1 flex-1 rounded-full bg-accent transition-colors duration-300"></div>
            <div class="progress-seg h-1 flex-1 rounded-full bg-white/10 transition-colors duration-300"></div>
            <div class="progress-seg h-1 flex-1 rounded-full bg-white/10 transition-colors duration-300"></div>
          </div>

          <div class="flex items-center justify-between px-8 pt-6 pb-0">
            <span id="step-label" class="text-sm text-white/50">Question 1 of 3</span>
            <button id="restart-btn" class="hidden text-sm text-white/40 hover:text-white transition-colors">
              Start over
            </button>
          </div>

          <div class="px-6 pt-8 pb-12 sm:px-12 sm:pt-10 sm:pb-14">

            <!-- Step 1 — multi-select -->
            <div id="step-1">
              <h3 class="font-serif text-2xl sm:text-3xl font-light tracking-tight text-white mb-2 leading-[1.15]">What matters most to you?</h3>
              <p class="text-sm text-white/40 mb-8">Select all that apply.</p>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <button class="q1-btn text-left border border-white/10 rounded-xl p-6 sm:p-7 hover:border-white/30 hover:bg-white/[0.05] transition-all duration-150"
                  data-value="calling-home">
                  <span class="text-2xl mb-4 block" aria-hidden="true">📞</span>
                  <p class="font-semibold text-lg text-white mb-1">Calling home</p>
                  <p class="text-sm text-white/50">Family &amp; friends</p>
                </button>
                <button class="q1-btn text-left border border-white/10 rounded-xl p-6 sm:p-7 hover:border-white/30 hover:bg-white/[0.05] transition-all duration-150"
                  data-value="data-heavy">
                  <span class="text-2xl mb-4 block" aria-hidden="true">📶</span>
                  <p class="font-semibold text-lg text-white mb-1">Maximum data</p>
                  <p class="text-sm text-white/50">Stream &amp; study</p>
                </button>
                <button class="q1-btn text-left border border-white/10 rounded-xl p-6 sm:p-7 hover:border-white/30 hover:bg-white/[0.05] transition-all duration-150"
                  data-value="budget">
                  <span class="text-2xl mb-4 block" aria-hidden="true">💸</span>
                  <p class="font-semibold text-lg text-white mb-1">Cheapest plan</p>
                  <p class="text-sm text-white/50">Tight budget</p>
                </button>
              </div>
              <div class="mt-8 flex justify-end">
                <button id="q1-continue" disabled
                  class="px-8 py-3 rounded-full text-sm font-medium bg-accent text-ink transition-all duration-150
                         disabled:opacity-30 disabled:cursor-not-allowed hover:not-disabled:scale-[1.03]">
                  Continue →
                </button>
              </div>
            </div>

            <!-- Step 2 -->
            <div id="step-2" class="hidden">
              <h3 class="font-serif text-2xl sm:text-3xl font-light tracking-tight text-white mb-10 leading-[1.15]">How long are you staying?</h3>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <button class="choice-btn text-left border border-white/10 rounded-xl p-6 sm:p-7 hover:border-white/30 hover:bg-white/[0.05] transition-all duration-150"
                  data-step="2" data-key="duration" data-value="short-stay">
                  <span class="text-2xl mb-4 block" aria-hidden="true">✈️</span>
                  <p class="font-semibold text-lg text-white mb-1">Under 3 months</p>
                  <p class="text-sm text-white/50">Short trip</p>
                </button>
                <button class="choice-btn text-left border border-white/10 rounded-xl p-6 sm:p-7 hover:border-white/30 hover:bg-white/[0.05] transition-all duration-150"
                  data-step="2" data-key="duration" data-value="long-stay">
                  <span class="text-2xl mb-4 block" aria-hidden="true">🎓</span>
                  <p class="font-semibold text-lg text-white mb-1">3 months – 2 years</p>
                  <p class="text-sm text-white/50">Student or work visa</p>
                </button>
                <button class="choice-btn text-left border border-white/10 rounded-xl p-6 sm:p-7 hover:border-white/30 hover:bg-white/[0.05] transition-all duration-150"
                  data-step="2" data-key="duration" data-value="long-stay">
                  <span class="text-2xl mb-4 block" aria-hidden="true">🏡</span>
                  <p class="font-semibold text-lg text-white mb-1">More than 2 years</p>
                  <p class="text-sm text-white/50">Permanent move</p>
                </button>
              </div>
            </div>

            <!-- Step 3 -->
            <div id="step-3" class="hidden">
              <h3 class="font-serif text-2xl sm:text-3xl font-light tracking-tight text-white mb-10 leading-[1.15]">Which country do you call most?</h3>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                {[
                  ['IN', '🇮🇳', 'India'], ['NP', '🇳🇵', 'Nepal'], ['PH', '🇵🇭', 'Philippines'], ['CN', '🇨🇳', 'China'],
                  ['BD', '🇧🇩', 'Bangladesh'], ['VN', '🇻🇳', 'Vietnam'], ['PK', '🇵🇰', 'Pakistan'], ['OTHER', '🌍', 'Other'],
                ].map(([code, flag, label]) => (
                  <button class="choice-btn text-left border border-white/10 rounded-xl p-5 hover:border-white/30 hover:bg-white/[0.05] transition-all duration-150"
                    data-step="3" data-key="country" data-value={code}>
                    <span class="text-3xl mb-2 block" aria-hidden="true">{flag}</span>
                    <p class="font-semibold text-base text-white">{label}</p>
                  </button>
                ))}
              </div>
            </div>

            <!-- Results -->
            <div id="step-results" class="hidden">
              <div id="results-banner"></div>
              <div id="top-match-container"></div>
              <div id="other-options-section" class="hidden mt-10">
                <h3 class="text-[11px] font-bold uppercase tracking-[0.18em] text-white/40 mb-4">Other options</h3>
                <div id="other-options-container" class="grid grid-cols-1 sm:grid-cols-2 gap-4"></div>
              </div>
              <p class="mt-10 text-center text-xs text-white/30">
                ✱ Data verified {stats.latestVerified} · Prices may change
              </p>
            </div>

          </div>
        </div>
      </section>

      <!-- ── 6. Who each choice suits ── -->
      <section class="mb-16 sm:mb-24">
        <h2 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-white leading-[1.1] mb-8">
          Which plan suits which student
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {resolvedSuitability.map((s) => (
            <article class="glass rounded-2xl p-6 flex flex-col">
              <h3 class="font-semibold text-white mb-2">{s.situation}</h3>
              <p class="text-xs text-white/40 mb-3"><span class="text-white/60 font-medium">What matters:</span> {s.matters}</p>
              <p class="text-sm text-white/60 leading-relaxed flex-1">{s.reasoning}</p>
              <p class="mt-4 text-sm">
                <span class="text-white/40">Start with:</span>
                <a href="#finder" class="text-accent font-medium hover:underline underline-offset-2 ml-1">{s.plan.name}</a>
              </p>
            </article>
          ))}
        </div>
      </section>

      <!-- ── 7. Price & feature details ── -->
      <section class="mb-16 sm:mb-24">
        <h2 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-white leading-[1.1] mb-8">
          How to compare plans fairly
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="glass rounded-2xl p-6">
            <h3 class="font-semibold text-white mb-2">Intro price vs ongoing price</h3>
            <p class="text-sm text-white/60 leading-relaxed">
              Several plans advertise a discounted first recharge (Lebara $30 starts at $11; Felix halves
              its price for 3 months with a code). Always compare the <em>ongoing</em> price — it's what
              you'll pay for the other 9+ months of the year.
            </p>
          </div>
          <div class="glass rounded-2xl p-6">
            <h3 class="font-semibold text-white mb-2">28-day renewals ≠ monthly</h3>
            <p class="text-sm text-white/60 leading-relaxed">
              {stats.cycle28Count} of the {stats.planCount} plans here renew every 28 days — 13 charges
              per year. A "$25" 28-day plan really costs about ${effectiveAnnualCost(planById('lebara-25'))}/year,
              not $300. Only Felix bills per calendar month.
            </p>
          </div>
          <div class="glass rounded-2xl p-6">
            <h3 class="font-semibold text-white mb-2">Data rollover &amp; caps</h3>
            <p class="text-sm text-white/60 leading-relaxed">
              Felix banks unused data indefinitely; most others expire it every cycle. "Unlimited" data on
              Felix Unlimited is speed-capped at 40Mbps, and some high-quota plans throttle after the cap.
            </p>
          </div>
          <div class="glass rounded-2xl p-6">
            <h3 class="font-semibold text-white mb-2">Network vs network footprint</h3>
            <p class="text-sm text-white/60 leading-relaxed">
              "Uses the Telstra network" isn't one thing. Boost resells the <em>full</em> Telstra footprint;
              Lycamobile uses Telstra wholesale, which is smaller. Vodafone-based plans (Lebara, Felix) are
              solid in cities, weakest regionally.
            </p>
          </div>
          <div class="glass rounded-2xl p-6">
            <h3 class="font-semibold text-white mb-2">International-call inclusions</h3>
            <p class="text-sm text-white/60 leading-relaxed">
              Country lists differ per plan, not per provider. India is widely included; Nepal appears
              in only Boost (300 min) and Lebara (30–50 min) plans. Check your exact country before buying,
              and re-check fair-use conditions on "unlimited" calls.
            </p>
          </div>
          <div class="glass rounded-2xl p-6">
            <h3 class="font-semibold text-white mb-2">Auto-renewal &amp; switching</h3>
            <p class="text-sm text-white/60 leading-relaxed">
              All plans here are prepaid with auto-recharge on by default — no exit fees, so switching is
              cheap. Turn off auto-recharge before you leave Australia, or a 28-day plan keeps billing.
            </p>
          </div>
        </div>
      </section>

      <!-- ── 8. Methodology ── -->
      <section id="methodology" class="mb-16 sm:mb-24 scroll-mt-24">
        <h2 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-white leading-[1.1] mb-3">
          How Arrivly compared these SIM plans
        </h2>
        <div class="glass rounded-2xl p-6 sm:p-8 space-y-4 text-sm text-white/60 leading-relaxed">
          <p>
            The comparison tool on this page runs a <strong class="text-white">filter-then-score</strong> process —
            the same one described here, with no hidden inputs:
          </p>
          <ul class="space-y-2 list-disc pl-5">
            <li><strong class="text-white/80">Hard filters first.</strong> If you say calling home matters, plans with no international calls are removed entirely. If you pick budget, plans over $25 are removed. If you call Nepal, plans with zero Nepal minutes are removed rather than ranked lower.</li>
            <li><strong class="text-white/80">Then scoring.</strong> Remaining plans earn points for matching your priorities (+30 each), your length of stay (+20), and whether your country is in the plan's unlimited list (+25) or minutes list (+20). Data quota acts as a tiebreaker, and Telstra-network plans get +15 for stays over two years because coverage matters more the longer you're here.</li>
            <li><strong class="text-white/80">Verification.</strong> Every figure was checked manually against the provider's own site or published Critical Information Summary on {stats.latestVerified}. Where we couldn't verify (Lycamobile's JS-rendered site), the caveat is printed on the results, not hidden.</li>
          </ul>
          <p>
            <strong class="text-white">Commission is not a scoring input.</strong> Some plan links earn
            Arrivly a commission; the ranking function contains no commission or payout field, and plans
            with no affiliate program are listed and recommended on the same basis. See our
            <a href="/affiliate-disclosure" class="text-white underline decoration-accent decoration-2 underline-offset-2 hover:text-accent transition-colors">full disclosure</a>.
          </p>
        </div>
      </section>

      <!-- ── 9. Pros and cons ── -->
      <section class="mb-16 sm:mb-24">
        <h2 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-white leading-[1.1] mb-8">
          Strengths and limitations of each pick
        </h2>
        <div class="space-y-4">
          {resolvedPicks.map((pick) => (
            <ProsCons
              title={pick.plan.name}
              subtitle={`${pick.plan.provider} · ${pick.plan.network} · $${pick.plan.price_ongoing_aud}${priceUnit(pick.plan)}`}
              pros={pick.plan.pros}
              cons={pick.plan.cons}
            />
          ))}
        </div>
      </section>

      <!-- ── 10. Warnings ── -->
      <section class="mb-16 sm:mb-24">
        <h2 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-white leading-[1.1] mb-8">
          Before you buy — the things people miss
        </h2>
        <div class="glass rounded-2xl border-l-4 border-l-amber-400/70 p-6 sm:p-8">
          <ul class="space-y-3.5 text-sm text-white/70 leading-relaxed">
            <li><strong class="text-amber-300">Your country may not be in the list.</strong> "Unlimited international calls" always means a specific country list. Nepal, for example, is missing from most of them.</li>
            <li><strong class="text-amber-300">Promotional prices end.</strong> Intro offers (first-recharge discounts, bonus data for 3 cycles) revert to the ongoing price — budget on the ongoing number.</li>
            <li><strong class="text-amber-300">28-day billing means 13 payments a year.</strong> {stats.cycle28Count} of {stats.planCount} plans here do this. It adds roughly one extra "month" of cost annually.</li>
            <li><strong class="text-amber-300">Coverage varies street by street.</strong> Ratings here are network-level. Check the provider's coverage map for your suburb and campus.</li>
            <li><strong class="text-amber-300">MVNO ≠ full network.</strong> Some resellers get the parent network's full footprint (Boost/Telstra); others get a reduced wholesale footprint (Lycamobile/Telstra wholesale).</li>
            <li><strong class="text-amber-300">eSIM needs a compatible, unlocked phone.</strong> We haven't verified per-plan eSIM availability yet — confirm directly with the provider before relying on it.</li>
            <li><strong class="text-amber-300">Everything here can change.</strong> Prices and inclusions were verified {stats.latestVerified}; providers change them without notice. Confirm on the provider's site before purchasing.</li>
          </ul>
        </div>
      </section>

      <!-- ── 11. Scenarios ── -->
      <section class="mb-16 sm:mb-24">
        <h2 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-white leading-[1.1] mb-8">
          Three real comparisons
        </h2>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
          {resolvedScenarios.map((s) => (
            <article class="glass rounded-2xl p-6 flex flex-col">
              <h3 class="font-serif text-xl font-light tracking-tight text-white leading-snug mb-4">{s.title}</h3>
              <dl class="space-y-3 text-sm flex-1">
                <div>
                  <dt class="text-[11px] font-bold uppercase tracking-[0.14em] text-white/40 mb-1">Needs</dt>
                  <dd class="text-white/60 leading-relaxed">{s.needs}</dd>
                </div>
                <div>
                  <dt class="text-[11px] font-bold uppercase tracking-[0.14em] text-white/40 mb-1">Considered</dt>
                  <dd class="text-white/60">{s.considered.map((p) => p.name).join(' · ')}</dd>
                </div>
                <div>
                  <dt class="text-[11px] font-bold uppercase tracking-[0.14em] text-white/40 mb-1">The trade-off</dt>
                  <dd class="text-white/60 leading-relaxed">{s.tradeoff}</dd>
                </div>
                <div>
                  <dt class="text-[11px] font-bold uppercase tracking-[0.14em] text-accent mb-1">Where we land</dt>
                  <dd class="text-white/80 leading-relaxed">{s.outcome}</dd>
                </div>
              </dl>
            </article>
          ))}
        </div>
      </section>

      <!-- ── 12. Original insight (computed) ── -->
      <section class="mb-16 sm:mb-24">
        <h2 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-white leading-[1.1] mb-3">
          The 28-day billing gap, in dollars
        </h2>
        <p class="text-sm text-white/50 mb-6 max-w-2xl">
          Calculated from the {stats.planCount} plans on this page: {stats.cycle28Count} renew every
          28 days. Here's what each headline "monthly" price actually costs across a year
          (ongoing price × 365 ÷ renewal days):
        </p>
        <div class="glass rounded-2xl overflow-x-auto">
          <table class="w-full min-w-[560px] text-sm text-left">
            <thead>
              <tr class="border-b border-white/10 text-[11px] uppercase tracking-[0.14em] text-white/40">
                <th scope="col" class="px-5 py-4 font-bold">Plan</th>
                <th scope="col" class="px-4 py-4 font-bold">Looks like / year</th>
                <th scope="col" class="px-4 py-4 font-bold">Actually costs / year</th>
                <th scope="col" class="px-4 py-4 font-bold">Hidden extra</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.06]">
              {stats.gapRanked.slice(0, 5).map((row) => (
                <tr>
                  <th scope="row" class="px-5 py-3.5 font-medium text-white whitespace-nowrap">{row.name}</th>
                  <td class="px-4 py-3.5 text-white/60">${row.headline}</td>
                  <td class="px-4 py-3.5 text-white/80">${row.effective}</td>
                  <td class="px-4 py-3.5 font-semibold text-accent">+${row.gap}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-xs text-white/30 mt-3">
          Across all {stats.cycle28Count} 28-day plans in this comparison, the gap between headline and
          effective annual cost totals ${stats.totalGapAcross28DayPlans} — cost that never appears in
          any provider's advertised price.
        </p>
      </section>

      <!-- ── 13. Sources ── -->
      <section class="mb-16 sm:mb-24">
        <h2 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-white leading-[1.1] mb-3">
          Sources and data notes
        </h2>
        <p class="text-sm text-white/50 mb-6 max-w-2xl">
          Official provider pages we verified against. These are editorial citations — separate from the
          plan CTAs above, which may be affiliate links and are labelled accordingly.
        </p>
        <SourceList sources={sources} />
      </section>

      <!-- ── 14. Author / review ── -->
      <section class="mb-16 sm:mb-24">
        <AuthorReview
          publishedDate="2026-07-21"
          reviewedDate="2026-07-21"
          verifiedDate={stats.latestVerified}
        />
      </section>

      <!-- ── 15. Conversion CTA ── -->
      <div class="mb-16 sm:mb-24">
        <CommercialCTA
          heading="Find the SIM plan that fits your stay in Australia"
          body="Three questions, ranked against the same verified data on this page. No signup needed — the result links straight to the provider."
          ctaText="Compare SIM plans"
          ctaHref="#finder"
        />
      </div>

      <!-- ── 16. Related guides ── -->
      <section class="mb-8">
        <h2 class="font-serif text-2xl sm:text-3xl font-light tracking-tight text-white leading-[1.1] mb-6">
          Keep reading
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a href="/blog/best-sim-card-international-students-australia-2026" class="glass rounded-2xl p-6 hover:border-white/25 transition-colors group">
            <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-white/40 mb-2">Guide</p>
            <p class="font-serif text-lg font-light text-white leading-snug group-hover:text-accent transition-colors">The iPhone plan trap that's costing international students $2,500</p>
          </a>
          <a href="/blog/how-i-saved-fees-money-as-international-student-raiz" class="glass rounded-2xl p-6 hover:border-white/25 transition-colors group">
            <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-white/40 mb-2">Guide</p>
            <p class="font-serif text-lg font-light text-white leading-snug group-hover:text-accent transition-colors">The app that saved me when uni fees were due</p>
          </a>
          <a href="/money-transfer" class="glass rounded-2xl p-6 hover:border-white/25 transition-colors group">
            <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-white/40 mb-2">Compare</p>
            <p class="font-serif text-lg font-light text-white leading-snug group-hover:text-accent transition-colors">Send money home without losing $40 to your bank</p>
          </a>
          <a href="/health-insurance" class="glass rounded-2xl p-6 hover:border-white/25 transition-colors group">
            <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-white/40 mb-2">Compare</p>
            <p class="font-serif text-lg font-light text-white leading-snug group-hover:text-accent transition-colors">OSHC and OVHC health cover, explained by visa</p>
          </a>
        </div>
      </section>

    </div>
  </div>

</BaseLayout>

<script define:vars={{ serialisedPlans }}>
  const PLANS = JSON.parse(serialisedPlans);

  // ── State ──────────────────────────────────────────────────────────────
  const answers = { priorities: [], duration: null, country: null };

  // ── DOM refs ───────────────────────────────────────────────────────────
  const stepLabel    = document.getElementById('step-label');
  const restartBtn   = document.getElementById('restart-btn');
  const progressSegs = document.querySelectorAll('.progress-seg');
  const q1Continue   = document.getElementById('q1-continue');

  const SELECTED_CLASSES = ['border-accent', 'bg-white/[0.08]'];

  // ── Helpers ────────────────────────────────────────────────────────────
  function countryCovered(plan, code) {
    if (!code || code === 'OTHER') return null;
    const c = plan.international_calls;
    if (!c.included) return null;
    if (c.unlimited_countries.includes(code)) return 'unlimited';
    if (c.limited_minutes_countries.includes(code)) return 'limited';
    return null;
  }

  function dataDisplay(plan) {
    return plan.data_gb >= 900 ? 'Unlimited' : `${plan.data_gb}GB`;
  }

  function coverageLabel(cov) {
    if (!cov) return null;
    const { metro, regional } = cov;
    if (regional === 'excellent') return 'Best for regional Australia';
    if (metro === 'excellent' && (regional === 'fair' || regional === 'poor')) return 'Best for metro areas';
    if ((metro === 'excellent' || metro === 'good') && regional === 'good') return 'Solid coverage Australia-wide';
    return 'Limited regional coverage';
  }

  // ── Progress ───────────────────────────────────────────────────────────
  function setProgress(step) {
    const fill = step === 'results' ? 3 : step;
    progressSegs.forEach((seg, i) => {
      seg.classList.toggle('bg-accent', i < fill);
      seg.classList.toggle('bg-white/10', i >= fill);
    });
  }

  // ── Hard filters ───────────────────────────────────────────────────────
  function filterPlans() {
    return PLANS.filter(plan => {
      if (answers.priorities.includes('calling-home') && !plan.international_calls.included) return false;
      if (answers.priorities.includes('budget') && plan.price_aud > 25) return false;
      if (isNepalScenario() && plan.international_calls.nepal_minutes <= 0) return false;
      return true;
    });
  }

  function isNepalScenario() {
    return answers.priorities.includes('calling-home') && answers.country === 'NP';
  }

  // ── Scoring ────────────────────────────────────────────────────────────
  function scorePlan(plan) {
    let score = 0;

    for (const p of answers.priorities) {
      if (plan.best_for.includes(p)) score += 30;
    }
    if (answers.duration && plan.best_for.includes(answers.duration)) score += 20;

    const match = countryCovered(plan, answers.country);
    if (match === 'unlimited') score += 25;
    else if (match === 'limited') score += 20;

    if (answers.priorities.includes('data-heavy')) {
      score += Math.min(plan.data_gb, 1000) * 0.1;
    } else {
      score += Math.min(plan.data_gb, 100) * 0.05;
    }

    if (answers.duration === 'long-stay' && (plan.network === 'Telstra' || plan.network === 'Telstra wholesale')) {
      score += 15;
    }

    return score;
  }

  // ── Card builders (dark glass restyle — logic identical) ───────────────
  function billingLine(plan) {
    if (!plan.billing_warning) {
      return `<p class="text-xs text-white/40 mt-2">Billed every ${plan.billing_cycle_days} days</p>`;
    }
    return `<p class="text-xs text-amber-300 mt-2">⚠ Billed every ${plan.billing_cycle_days} days — that's 13 payments per year, not 12</p>`;
  }

  function dataNoteHtml(plan) {
    return plan.data_note
      ? `<p class="text-xs text-white/50 mt-1">${plan.data_note}</p>`
      : '';
  }

  function lycamobileDisclaimer(plan) {
    if (plan.provider !== 'Lycamobile') return '';
    return `<div class="mt-4 px-3 py-2 rounded-lg bg-amber-400/10 border border-amber-400/30 text-xs text-amber-300">
      Country list pending full verification — check lycamobile.com.au for current inclusions.
    </div>`;
  }

  function verificationFooter(plan) {
    return `<p class="text-xs text-white/30 mt-5">Data verified: ${plan.last_verified} · ${plan.verified_source}</p>`;
  }

  function ctaUrl(plan) {
    return (plan.affiliate_url && plan.affiliate_url !== 'PLACEHOLDER')
      ? plan.affiliate_url
      : plan.official_url;
  }
  function ctaRel(plan) {
    return (plan.affiliate_url && plan.affiliate_url !== 'PLACEHOLDER')
      ? 'sponsored noopener noreferrer'
      : 'noopener';
  }

  function buildTopCard(plan) {
    const match = countryCovered(plan, answers.country);
    const hasIntl = plan.international_calls.included;
    const intlValue = hasIntl ? '✓' : '—';
    const intlColor = hasIntl ? 'text-white' : 'text-white/30';

    let countryDisplay = '—';
    let countryColor = 'text-white/30';
    if (match === 'unlimited') { countryDisplay = '✓'; countryColor = 'text-white'; }
    else if (match === 'limited') {
      countryDisplay = `${plan.international_calls.limited_minutes_amount}m`;
      countryColor = 'text-white';
    } else if (answers.country && answers.country !== 'OTHER') {
      countryDisplay = '✗';
    }

    const countryBlock = answers.country
      ? `<div>
          <p class="text-xl sm:text-2xl font-bold ${countryColor}">${countryDisplay}</p>
          <p class="text-sm text-white/50 mt-0.5">Your country</p>
        </div>`
      : '';
    const cols = answers.country ? 'grid-cols-3' : 'grid-cols-2';
    const coverage = coverageLabel(plan.coverage);

    return `
      <div>
        <div class="inline-flex mb-4">
          <span class="bg-accent text-ink px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-[0.18em]">
            Your top match
          </span>
        </div>

        <div class="rounded-3xl p-7 sm:p-9 border border-accent/40 bg-white/[0.04] shadow-[0_0_40px_rgba(200,240,100,0.07)]">
          <div class="flex items-start justify-between gap-4 mb-8">
            <div>
              <h3 class="font-serif text-2xl sm:text-3xl font-light tracking-tight text-white leading-[1.15]">${plan.name}</h3>
              <p class="text-sm text-white/40 mt-2">${plan.network} · ${plan.network_type}</p>
              ${coverage ? `<p class="text-xs text-white/40 mt-0.5">${coverage}</p>` : ''}
            </div>
            <div class="text-right shrink-0">
              <span class="text-3xl sm:text-4xl font-bold text-accent">$${plan.price_aud}</span>
              <span class="text-sm text-white/40 block">/month</span>
              ${billingLine(plan)}
            </div>
          </div>

          ${plan.price_intro_note ? `<div class="mb-6 px-3 py-2 rounded-lg bg-accent/10 border border-accent/40 text-xs text-white">Intro offer: ${plan.price_intro_note}</div>` : ''}

          <div class="grid ${cols} gap-6 py-7 border-y border-white/10 mb-1">
            <div>
              <p class="text-xl sm:text-2xl font-bold text-white">${dataDisplay(plan)}</p>
              <p class="text-sm text-white/50 mt-0.5">Data</p>
              ${dataNoteHtml(plan)}
            </div>
            <div>
              <p class="text-xl sm:text-2xl font-bold ${intlColor}">${intlValue}</p>
              <p class="text-sm text-white/50 mt-0.5">International calls</p>
            </div>
            ${countryBlock}
          </div>

          ${lycamobileDisclaimer(plan)}

          <ul class="space-y-2.5 mt-7 mb-8">
            ${plan.pros.map(p => `
              <li class="flex items-start gap-3 text-sm text-white/60">
                <span class="mt-0.5 shrink-0 text-accent">✓</span>${p}
              </li>`).join('')}
          </ul>

          <a href="${ctaUrl(plan)}" target="_blank" rel="${ctaRel(plan)}"
            class="flex items-center justify-center gap-2 w-full bg-accent text-ink font-medium text-sm py-4 rounded-full hover:scale-[1.01] shadow-[0_0_28px_rgba(200,240,100,0.25)] transition-transform">
            Get this SIM <span aria-hidden="true">→</span>
          </a>

          ${verificationFooter(plan)}
        </div>
      </div>`;
  }

  function buildAltCard(plan) {
    const match = countryCovered(plan, answers.country);
    const hasIntl = plan.international_calls.included;
    const coverage = coverageLabel(plan.coverage);

    let countryNote = '';
    if (match === 'unlimited') countryNote = `Unlimited to ${answers.country}`;
    else if (match === 'limited') countryNote = `${plan.international_calls.limited_minutes_amount}m to ${answers.country}`;
    else if (answers.country && answers.country !== 'OTHER') countryNote = `${answers.country} not covered`;

    return `
      <div class="rounded-2xl p-6 border border-white/10 bg-white/[0.04]">
        <div class="flex items-start justify-between gap-2 mb-1">
          <p class="font-semibold text-white">${plan.name}</p>
          <div class="text-right shrink-0">
            <span class="font-bold text-accent">$${plan.price_aud}</span>
            <span class="text-xs text-white/40">/mo</span>
          </div>
        </div>
        <p class="text-xs text-white/40 mb-1">${plan.network}${coverage ? ' · ' + coverage : ''}</p>
        ${plan.billing_warning ? `<p class="text-xs text-amber-300 mb-3">⚠ Billed every ${plan.billing_cycle_days} days</p>` : `<p class="text-xs text-white/40 mb-3">Billed every ${plan.billing_cycle_days} days</p>`}
        <div class="flex flex-wrap gap-x-3 gap-y-1 text-sm text-white/60 mb-4">
          <span>${dataDisplay(plan)}</span>
          <span>·</span>
          <span>${hasIntl ? 'Intl calls' : 'No intl calls'}</span>
          ${countryNote ? `<span>·</span><span>${countryNote}</span>` : ''}
        </div>
        ${plan.data_note ? `<p class="text-xs text-white/50 mb-4">${plan.data_note}</p>` : ''}
        ${plan.provider === 'Lycamobile' ? `<p class="text-xs text-amber-300 mb-4">⚠ Country list pending verification</p>` : ''}
        <a href="${ctaUrl(plan)}" target="_blank" rel="${ctaRel(plan)}"
          class="flex items-center justify-center gap-1.5 w-full border border-white/15 text-white text-sm font-medium py-2.5 rounded-full hover:border-accent hover:text-accent transition-colors">
          Get this SIM <span aria-hidden="true">→</span>
        </a>
        <p class="text-xs text-white/30 mt-3">Verified ${plan.last_verified}</p>
      </div>`;
  }

  // ── Navigation ─────────────────────────────────────────────────────────
  function goToStep(n) {
    document.querySelectorAll('[id^="step-"]').forEach(el => el.classList.add('hidden'));

    if (n === 'results') {
      document.getElementById('step-results').classList.remove('hidden');
      setProgress('results');
      stepLabel.textContent = 'Results';
      restartBtn.classList.remove('hidden');
      renderResults();
    } else {
      document.getElementById(`step-${n}`).classList.remove('hidden');
      setProgress(n);
      stepLabel.textContent = `Question ${n} of 3`;
      restartBtn.classList.toggle('hidden', n === 1);
    }
  }

  function renderResults() {
    const banner   = document.getElementById('results-banner');
    const topEl    = document.getElementById('top-match-container');
    const altSec   = document.getElementById('other-options-section');
    const altCont  = document.getElementById('other-options-container');

    let pool = filterPlans();

    if (isNepalScenario()) {
      pool = pool.slice().sort((a, b) => {
        const diff = b.international_calls.nepal_minutes - a.international_calls.nepal_minutes;
        if (diff !== 0) return diff;
        return b.data_gb - a.data_gb;
      });
      banner.innerHTML = `
        <div class="mb-6 px-5 py-4 rounded-xl bg-white/[0.05] border-l-4 border-accent">
          <p class="text-sm text-white font-semibold">📞 Heads up about Nepal calling</p>
          <p class="text-xs text-white/60 mt-1.5 leading-relaxed">
            Only Boost and Lebara include Nepal calling in their plans.
            Boost gives you 300 mins, Lebara gives you 30–50 mins. All other Australian SIMs offer no Nepal minutes.
          </p>
        </div>`;
    } else {
      banner.innerHTML = '';
      pool = pool
        .map(p => ({ plan: p, score: scorePlan(p) }))
        .sort((a, b) => b.score - a.score)
        .map(x => x.plan);
    }

    if (pool.length === 0) {
      topEl.innerHTML = `
        <div class="text-center py-12">
          <p class="text-white/60 mb-4">No plans match your exact criteria.</p>
          <button onclick="document.getElementById('restart-btn').click()"
            class="text-sm font-medium text-white underline decoration-2 decoration-accent underline-offset-2">
            Start over and adjust your answers
          </button>
        </div>`;
      altSec.classList.add('hidden');
      return;
    }

    const top3 = pool.slice(0, 3);
    topEl.innerHTML = buildTopCard(top3[0]);

    const rest = top3.slice(1);
    if (rest.length > 0) {
      altCont.innerHTML = rest.map(p => buildAltCard(p)).join('');
      altSec.classList.remove('hidden');
    } else {
      altSec.classList.add('hidden');
    }
  }

  // ── Reset ──────────────────────────────────────────────────────────────
  restartBtn.addEventListener('click', () => {
    answers.priorities = [];
    answers.duration   = null;
    answers.country    = null;
    document.querySelectorAll('.q1-btn, .choice-btn').forEach(b =>
      b.classList.remove(...SELECTED_CLASSES)
    );
    q1Continue.disabled = true;
    goToStep(1);
  });

  // ── Q1 multi-select ────────────────────────────────────────────────────
  document.querySelectorAll('.q1-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const value = btn.dataset.value;
      const idx   = answers.priorities.indexOf(value);
      if (idx === -1) {
        answers.priorities.push(value);
        btn.classList.add(...SELECTED_CLASSES);
      } else {
        answers.priorities.splice(idx, 1);
        btn.classList.remove(...SELECTED_CLASSES);
      }
      q1Continue.disabled = answers.priorities.length === 0;
    });
  });

  q1Continue.addEventListener('click', () => goToStep(2));

  // ── Q2 & Q3 single-select ─────────────────────────────────────────────
  document.querySelectorAll('.choice-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const step  = parseInt(btn.dataset.step);
      const key   = btn.dataset.key;
      const value = btn.dataset.value;

      document.querySelectorAll(`[data-step="${step}"]`).forEach(b =>
        b.classList.remove(...SELECTED_CLASSES)
      );
      btn.classList.add(...SELECTED_CLASSES);

      answers[key] = value;

      setTimeout(() => {
        step < 3 ? goToStep(step + 1) : goToStep('results');
      }, 180);
    });
  });

  // ── Init ───────────────────────────────────────────────────────────────
  goToStep(1);
</script>
