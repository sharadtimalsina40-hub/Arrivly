---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/commercial/Breadcrumbs.astro';
import CommercialCTA from '../../components/commercial/CommercialCTA.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFmt = post.data.pubDate.toLocaleDateString('en-AU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const isoDate = post.data.pubDate.toISOString().slice(0, 10);
const canonical = `https://arrivly.com.au/blog/${post.id}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: isoDate,
    url: canonical,
    author: { '@type': 'Organization', name: 'Arrivly', url: 'https://arrivly.com.au' },
    publisher: { '@type': 'Organization', name: 'Arrivly', url: 'https://arrivly.com.au' },
    ...(post.data.tags ? { keywords: post.data.tags.join(', ') } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://arrivly.com.au/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://arrivly.com.au/blog' },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
    ],
  },
];
---

<BaseLayout
  title={`${post.data.title} — Arrivly`}
  description={post.data.description}
  canonical={canonical}
  theme="dark">

  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="relative hero-glow grain">
    <article class="max-w-[720px] mx-auto px-4 sm:px-6 pt-8 pb-16 sm:pb-24 relative">

      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog' }, { label: post.data.title }]} />

      <!-- Header -->
      <header class="mt-10 sm:mt-14 mb-10">
        <p class="text-xs text-white/40 tracking-wide mb-4">{dateFmt} · {post.data.author}</p>
        <h1 class="font-serif text-4xl sm:text-5xl font-light tracking-tight text-white leading-[1.1] mb-5">
          {post.data.title}
        </h1>
        <p class="text-lg text-white/70 leading-relaxed">{post.data.description}</p>
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-6">
            {post.data.tags.map((tag) => (
              <span class="text-[11px] font-medium text-white/50 border border-white/10 rounded-full px-2.5 py-0.5">{tag}</span>
            ))}
          </div>
        )}
      </header>

      <!-- Rendered markdown (dark prose via .theme-dark .prose) -->
      <div class="prose">
        <Content />
      </div>

      <!-- Footer CTA -->
      <div class="mt-16">
        <CommercialCTA
          heading="Find your best SIM plan in 30 seconds"
          body="Answer three quick questions — we'll rank 12 verified Australian plans by how well they actually fit your situation."
          ctaText="Compare SIM cards"
          ctaHref="/sim-cards"
        />
      </div>

      <a href="/blog" class="inline-flex items-center gap-1.5 text-sm text-white/50 hover:text-white transition-colors mt-10">
        <span aria-hidden="true">←</span> Back to all articles
      </a>
    </article>
  </div>

</BaseLayout>
