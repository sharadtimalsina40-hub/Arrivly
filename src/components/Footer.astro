---
// Site footer — newsletter strip + three columns + full-width disclaimer.
// Theme-aware: `dark` renders the glass-on-charcoal variant.
const { theme = 'light' } = Astro.props;
const dark = theme === 'dark';

const stripBg   = dark ? 'bg-white/[0.03] border-t border-white/10' : 'bg-[#f0f0ee] border-t border-black/5';
const heading   = dark ? 'text-white' : 'text-ink';
const subtext   = dark ? 'text-white/60' : 'text-gray-600';
const inputCls  = dark
  ? 'flex-1 glass rounded-lg px-4 py-3 text-base text-white placeholder:text-white/40 focus:outline-none focus:border-accent transition-colors'
  : 'flex-1 border border-gray-300 rounded-lg px-4 py-3 text-base bg-white focus:outline-none focus:border-ink transition-colors';
const btnCls    = dark
  ? 'bg-accent text-ink px-6 py-3 rounded-lg font-medium hover:scale-[1.02] shadow-[0_0_24px_rgba(200,240,100,0.25)] transition-transform'
  : 'bg-ink text-paper px-6 py-3 rounded-lg font-medium hover:bg-accent hover:text-ink transition-colors';
const footBg    = dark ? 'border-t border-white/10' : 'border-t border-black/5';
const colLabel  = dark ? 'text-white/40' : 'text-faint';
const link      = dark ? 'text-white/60 hover:text-white transition-colors' : 'text-ink hover:text-muted transition-colors';
const mutedTxt  = dark ? 'text-white/40' : 'text-faint';
const brandTxt  = dark ? 'text-white' : 'text-ink';
const tagline   = dark ? 'text-white/50' : 'text-muted';
const arrowCol  = dark ? '#0a0a0a' : 'white';
---

<!-- ── Email capture strip — above the main footer ── -->
<section class={`${stripBg} px-6 py-10 mt-16`}>
  <div class="max-w-2xl mx-auto text-center">
    <div id="arrivly-footer-form-container">
      <h3 class={`font-serif text-2xl font-light tracking-tight ${heading} mb-2 leading-tight`}>
        Stay ahead of the best deals
      </h3>
      <p class={`text-sm ${subtext} leading-relaxed mb-5 max-w-xl mx-auto`}>
        New SIM plans, money transfer rate drops, student bank offers — straight to your inbox.
      </p>
      <form id="arrivly-footer-form" class="flex flex-col sm:flex-row gap-3 max-w-lg mx-auto" novalidate>
        <input
          id="arrivly-footer-email"
          type="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
          class={inputCls} />
        <button type="submit" class={btnCls}>
          Get updates
        </button>
      </form>
    </div>

    <div id="arrivly-footer-success"
      class="hidden text-green-500 text-base font-medium py-6">
      You're on the list!
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var SHEET_URL = 'https://script.google.com/macros/s/AKfycbzZcrFrHRfha_xGF-8c6bbMP-VU74JzPV2xPGPWyYPaIE71vKj7ItU2vSuOqlp-cihZ/exec';
    var form     = document.getElementById('arrivly-footer-form');
    var formWrap = document.getElementById('arrivly-footer-form-container');
    var success  = document.getElementById('arrivly-footer-success');
    var emailEl  = document.getElementById('arrivly-footer-email');
    if (!form || !formWrap || !success || !emailEl) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var email = (emailEl.value || '').trim();
      if (!email || email.indexOf('@') === -1) {
        emailEl.focus();
        return;
      }

      fetch(SHEET_URL, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify({ email: email, source: 'footer' })
      }).catch(function () { /* opaque — treat any completion as success */ });

      formWrap.classList.add('hidden');
      success.classList.remove('hidden');
    });
  })();
</script>

<footer class={`px-6 sm:px-10 pt-16 pb-10 ${footBg}`}>
  <div class="max-w-6xl mx-auto">

    <!-- ── Top row: logo + 3 columns ── -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-10 sm:gap-12 mb-12">

      <!-- Brand block -->
      <div class="sm:col-span-1">
        <div class="inline-flex items-center gap-2 mb-3">
          <span class="w-6 h-6 rounded-md bg-accent flex items-center justify-center">
            <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" aria-hidden="true">
              <path d="M12 2L12 14M12 14L8 10M12 14L16 10M4 18H20"
                stroke={arrowCol} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            </svg>
          </span>
          <span class={`font-serif text-xl font-semibold tracking-tight ${brandTxt}`}>Arrivly</span>
        </div>
        <p class={`text-sm ${tagline} leading-relaxed max-w-[14rem]`}>
          Because the first weeks are hard enough.
        </p>
      </div>

      <!-- Compare -->
      <div>
        <p class={`text-[11px] font-bold uppercase tracking-[0.18em] ${colLabel} mb-4`}>Compare</p>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/sim-cards" class={link}>SIM cards</a></li>
          <li><a href="/health-insurance" class={link}>Health insurance</a></li>
          <li><span class={mutedTxt}>Banking &amp; Credit <span class="text-[10px] ml-1">Coming soon</span></span></li>
          <li><a href="/money-transfer" class={link}>Money transfer</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <p class={`text-[11px] font-bold uppercase tracking-[0.18em] ${colLabel} mb-4`}>Company</p>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/about" class={link}>About</a></li>
          <li><a href="/blog" class={link}>Blog</a></li>
          <li><a href="mailto:contact@arrivly.com.au" class={link}>Contact</a></li>
          <li><a href="/affiliate-disclosure" class={link}>Affiliate disclosure</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <p class={`text-[11px] font-bold uppercase tracking-[0.18em] ${colLabel} mb-4`}>Legal</p>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/privacy" class={link}>Privacy policy</a></li>
          <li><a href="/terms" class={link}>Terms of use</a></li>
          <li><a href="/disclaimer" class={link}>General disclaimer</a></li>
          <li><span class={mutedTxt}>Data verified: May 2026</span></li>
        </ul>
      </div>

    </div>

    <!-- ── Bottom disclaimer ── -->
    <div class={`pt-8 ${footBg}`}>
      <p class={`text-xs ${mutedTxt} leading-relaxed max-w-4xl`}>
        Arrivly is not a financial adviser, insurance broker, or migration agent. Information on this site is general in nature.
        Always verify plan details with the provider before purchasing. Some links earn us a commission — this does not affect our recommendations.
        <span class="block mt-2">© 2026 Arrivly. All rights reserved.</span>
      </p>
    </div>

  </div>
</footer>
