---
// Nav — theme-aware. `dark` renders the floating glass pill bar;
// default (light) keeps the original header until each page migrates.
const { theme = 'light' } = Astro.props;
const dark = theme === 'dark';
---
{dark ? (
  <header class="sticky top-4 z-40 px-4">
    <div class="glass rounded-full max-w-5xl mx-auto flex items-center justify-between gap-4 pl-5 pr-3 py-2.5">
      <a href="/" class="inline-flex items-center gap-2 group shrink-0">
        <span class="w-6 h-6 rounded-md bg-accent flex items-center justify-center group-hover:scale-105 transition-transform">
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" aria-hidden="true">
            <path d="M12 2L12 14M12 14L8 10M12 14L16 10M4 18H20"
              stroke="#0a0a0a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          </svg>
        </span>
        <span class="font-serif text-xl font-semibold tracking-tight text-white">Arrivly</span>
      </a>

      <nav class="flex items-center gap-1 sm:gap-2 text-sm">
        <a href="/sim-cards" class="px-3 py-1.5 rounded-full text-white/80 hover:text-accent transition-colors hidden sm:block">SIM cards</a>
        <a href="/health-insurance" class="px-3 py-1.5 rounded-full text-white/80 hover:text-accent transition-colors hidden md:block">Health insurance</a>
        <a href="/money-transfer" class="px-3 py-1.5 rounded-full text-white/80 hover:text-accent transition-colors hidden sm:block">Money transfer</a>
        <a href="/blog" class="px-3 py-1.5 rounded-full text-white/80 hover:text-accent transition-colors">Blog</a>
        <a href="/sim-cards" class="ml-1 px-4 py-1.5 rounded-full bg-accent text-ink font-medium hover:scale-[1.03] transition-transform sm:hidden">Compare</a>
      </nav>
    </div>
  </header>
) : (
  <header class="px-6 sm:px-10 py-6">
    <div class="max-w-6xl mx-auto flex items-center justify-between gap-4">
      <a href="/" class="inline-flex items-center gap-2 group shrink-0">
        <span class="w-6 h-6 rounded-md bg-accent flex items-center justify-center group-hover:scale-105 transition-transform">
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" aria-hidden="true">
            <path d="M12 2L12 14M12 14L8 10M12 14L16 10M4 18H20"
              stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          </svg>
        </span>
        <span class="font-serif text-xl font-semibold tracking-tight text-ink">Arrivly</span>
      </a>

      <nav class="hidden sm:flex items-center gap-6 text-sm">
        <a href="/sim-cards" class="text-muted hover:text-ink transition-colors">SIM cards</a>
        <a href="/health-insurance" class="text-muted hover:text-ink transition-colors">Health insurance</a>
        <a href="/money-transfer" class="text-muted hover:text-ink transition-colors">Money transfer</a>
        <a href="/blog" class="text-muted hover:text-ink transition-colors">Blog</a>
      </nav>
    </div>
  </header>
)}
