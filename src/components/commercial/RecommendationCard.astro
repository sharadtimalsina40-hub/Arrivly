---
// One "direct answer" pick. props:
//   category: string — e.g. "Best for calling Nepal"
//   plan: resolved plan record from the vertical's data file
//   reason: string — data-supported selection reason
//   priceUnit: string — e.g. "/28 days" | "/month"
//   dataLabel: string — e.g. "25GB"
//   ctaHref, ctaRel: computed by the page (affiliate vs official)
const { category, plan, reason, priceUnit, dataLabel, ctaHref, ctaRel } = Astro.props;
---
<article class="glass rounded-2xl p-6 flex flex-col">
  <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-accent mb-3">{category}</p>
  <div class="flex items-start justify-between gap-3 mb-1">
    <h3 class="font-serif text-xl font-light tracking-tight text-white leading-snug">{plan.name}</h3>
    <p class="text-right shrink-0">
      <span class="text-xl font-bold text-accent">${plan.price_ongoing_aud}</span>
      <span class="text-xs text-white/40 block">{priceUnit}</span>
    </p>
  </div>
  <p class="text-xs text-white/40 mb-3">{plan.provider} · {plan.network} · {dataLabel}</p>
  <p class="text-sm text-white/60 leading-relaxed flex-1">{reason}</p>
  <p class="text-xs text-white/30 mt-4 mb-4">Last checked {plan.last_verified}</p>
  <a href={ctaHref} target="_blank" rel={ctaRel}
    class="inline-flex items-center justify-center gap-1.5 border border-white/15 text-white text-sm font-medium py-2.5 rounded-full hover:border-accent hover:text-accent transition-colors">
    View plan <span aria-hidden="true">→</span>
  </a>
</article>
